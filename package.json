{
  "name": "near-ai-services-operating-system",
  "version": "0.1.0",
  "private": true,
  "description": "Slack-first operating system for Near AI Services with Google Sheets as the source of truth.",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "NODE_ENV=development node src/index.js",
    "test": "node --test test/*.test.js",
