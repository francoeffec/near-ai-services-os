    "validate:env": "node scripts/validate-env.js",
    "bootstrap:sheet": "node scripts/bootstrap-sheet.js",
    "sync:metrics": "node scripts/sync-weekly-metrics.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@slack/bolt": "^4.0.0",
    "express": "^4.18.3",
    "googleapis": "^150.0.0"
  },
  "devDependencies": {}
}
