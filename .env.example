# Runtime
NODE_ENV=production
PORT=3000
BASE_URL=https://nearai-services.example.com

# Google Sheets
GOOGLE_SPREADSHEET_ID=1SzVtD8Ql94nGo6hw-FMwnTH_Ur3kIr2zW-d7AqFOrks
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# Optional alternative when your deployment provider mangles raw JSON.
GOOGLE_SERVICE_ACCOUNT_JSON_B64=
# Optional alternative to a service account: Apps Script proxy deployed as a web app.
GOOGLE_SCRIPT_WEB_APP_URL=
GOOGLE_SCRIPT_SHARED_SECRET=

# Slack app
SLACK_BOT_TOKEN=xoxb-...
SLACK_SIGNING_SECRET=...
SLACK_APP_TOKEN=xapp-...
SLACK_AI_LEADS_CHANNEL_ID=C0B63R2TC3V
SLACK_HANDOFF_CHANNEL_ID=C0B63R2TC3V
SLACK_ALLOWED_USER_IDS=
SLACK_ALLOWED_CHANNEL_IDS=C0B63R2TC3V

# AI extraction
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini

# Webhook protection
WEBHOOK_SHARED_SECRET=replace-me
ADMIN_TOKEN=replace-me
ENABLE_SCHEDULER=false
WEEKLY_METRICS_SYNC_HOUR_UTC=12
WEEKLY_METRICS_SYNC_MINUTE_UTC=0

# Smartlead
SMARTLEAD_API_KEY=...
SMARTLEAD_BASE_URL=https://server.smartlead.ai/api/v1
SMARTLEAD_INCLUDED_CAMPAIGN_MATCH=AI
SMARTLEAD_EXCLUDED_STATUSES=PAUSED,COMPLETED,ARCHIVED
SMARTLEAD_TIMEZONE=America/Argentina/Buenos_Aires

# Optional booking/calendar bridge
GOOGLE_CALENDAR_IDS=
BOOKING_EVENT_TITLE_MATCH=AI Automation,+ Near

# Optional Fathom
FATHOM_API_KEY=
FATHOM_BASE_URL=https://api.fathom.ai/external/v1
